<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Single Submit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tembak Hari Ini / Tanggal Spesifik"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDateDisplay"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_white"
                    android:paddingHorizontal="12dp"
                    android:text="Pilih Tanggal"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnPickDate"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Ubah"
                    android:textColor="@color/primary"
                    android:background="@drawable/card_white"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etJamMulai"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="08:15"
                    android:text="08:15"
                    android:gravity="center"
                    android:background="@drawable/card_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sd"
                    android:textColor="@color/text_secondary"
                    android:layout_marginHorizontal="8dp" />

                <EditText
                    android:id="@+id/etJamSelesai"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="15:30"
                    android:text="15:30"
                    android:gravity="center"
                    android:background="@drawable/card_white" />

                <Button
                    android:id="@+id/btnReroll"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Acak Jam"
                    android:textColor="@color/primary"
                    android:background="@drawable/card_white"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Preset Kegiatan:"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp" />

            <Spinner
                android:id="@+id/spinnerPresets"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/card_white"
                android:layout_marginTop="6dp" />

            <EditText
                android:id="@+id/etKegiatan"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="top"
                android:padding="10dp"
                android:background="@drawable/card_white"
                android:hint="Uraian kegiatan teknik..."
                android:textSize="13sp"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Matakuliah otomatis 'Tidak'. Sanitasi kata SQL aktif."
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnSubmitSingle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="TEMBAK KE MIS PENS"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
